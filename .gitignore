# Claude Code 로컬 설정 (공유하지 않는다)
.claude/settings.local.json

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# 검증용 임시 자막·영상 (샘플은 tests/fixtures/ 에 둔다)
/tmp-verify/

# 실제 미디어 표본 (용량이 크다. 절대 커밋하지 않는다)
/sample/

# 텍스트 추출용 별도 환경 (선택 설치, 436MB)
/.venv-stt/
/.venv/

# deb 빌드 중간물은 무시하되, 배포용 .deb 는 올린다
# (56 KB 라 git 에 부담이 없고, 다른 머신에서 바로 받아 설치할 수 있다)
/dist/*
!/dist/*.deb
